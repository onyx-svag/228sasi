    local skinsFolder = repStorage:FindFirstChild("Assets") and repStorage.Assets:FindFirstChild("Skins")
    if not skinsFolder then return end
    
    local toolName = mesh.Name:lower()
    for configWeapon, equippedSkin in pairs(v12.EquippedRealSkins or {}) do
        if string.find(toolName, configWeapon:lower()) then
            local cleanSkinName = v88(equippedSkin)
            local weaponSkins = skinsFolder:FindFirstChild(configWeapon)
            if weaponSkins then
                local skinModel = weaponSkins:FindFirstChild(cleanSkinName)
                if skinModel then
                    for _, textureSource in ipairs(skinModel:GetChildren()) do
                        if textureSource:IsA("SurfaceAppearance") then
                            for _, part in ipairs(mesh:GetDescendants()) do
                                if part:IsA("MeshPart") then
