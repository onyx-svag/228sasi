function v21.GetCharacter(player)
    if not player then return nil end
    local char = player.Character
    if char and char.Parent and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")) then
        return char
    end
    local charactersFolder = v2.FindFirstChild(v2, "Characters")
    if charactersFolder then
        local found = charactersFolder:FindFirstChild(player.Name)
        if found and found:IsA("Model") and (found:FindFirstChild("HumanoidRootPart") or found:FindFirstChild("Head")) then
            return found
        end
    end
    local directChar = v2.FindFirstChild(v2, player.Name)
    if directChar and directChar:IsA("Model") and (directChar:FindFirstChild("HumanoidRootPart") or directChar:FindFirstChild("Head")) then
        return directChar
    end
    return nil
end

function v21.Get(player)
    if v21.Objects[player] then
        return v21.Objects[player]
    end
    local container = {
        Player = player,
        Billboard = nil,
        Label = nil,
        HealthContainer = nil,
        HealthFill = nil,
        WeaponLabel = nil,
        BoxFrame = nil,
        BoxStroke = nil,
        TracerLine = nil,
        HeadDot = nil,
        SkeletonLines = {},
        Highlight = nil,
        RadarDot = nil,
        LastText = "",
        LastRatio = -1,
        LastWeapon = ""
    }
    v21.Objects[player] = container
    return container
end

function v21.Remove(player)
    local obj = v21.Objects[player]
    if not obj then return end
    pcall(function() if obj.Billboard then obj.Billboard:Destroy() end end)
    pcall(function() if obj.BoxFrame then obj.BoxFrame:Destroy() end end)
    pcall(function() if obj.TracerLine then obj.TracerLine:Destroy() end end)
    pcall(function() if obj.HeadDot then obj.HeadDot:Destroy() end end)
    pcall(function() if obj.Highlight then obj.Highlight:Destroy() end end)
    pcall(function() if obj.RadarDot then obj.RadarDot:Destroy() end end)
    for _, boneLine in pairs(obj.SkeletonLines) do
        pcall(function() boneLine:Destroy() end)
    end
    v21.Objects[player] = nil
end

function v21.ClearAll()
    for player, _ in pairs(v21.Objects) do
        v21.Remove(player)
    end
    table.clear(v21.Objects)
end

