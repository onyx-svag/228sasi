local function v26(className, properties, children)
    local element = Instance.new(className)
    local parent
    for prop, val in pairs(properties or {}) do
        if prop == "Parent" then
            parent = val
        else
            element[prop] = val
        end
    end
    for _, child in ipairs(children or {}) do
        if child then child.Parent = element end
    end
    if parent then element.Parent = parent end
    return element
end

