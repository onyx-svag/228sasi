local function v28(player1, player2)
    if not player1 or not player2 then return false end
    if player1 == player2 then return true end
    if player1.Team and player2.Team then
        return player1.Team == player2.Team
    end
    local char1 = v21.GetCharacter(player1)
    local char2 = v21.GetCharacter(player2)
    if char1 and char2 and char1.Parent and char2.Parent then
        local teamName1 = char1.Parent.Name:lower()
        local teamName2 = char2.Parent.Name:lower()
        if teamName1 == teamName2 and (teamName1:find("terrorist") or teamName1:find("counter") or teamName1 == "t" or teamName1 == "ct") then
            return true
        end
    end
    if player1.TeamColor and player2.TeamColor and player1.TeamColor ~= BrickColor.new("Medium stone grey") then
        return player1.TeamColor == player2.TeamColor
    end
    return false
end

