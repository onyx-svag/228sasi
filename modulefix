-- Активация ProximityPrompt
local function triggerPrompt(prompt)
    if not prompt then return false end
    pcall(function()
        prompt:InputHoldBegin(LocalPlayer)
        task.wait(0.1)
        prompt:InputHoldEnd(LocalPlayer)
    end)
    return true
end

-- Продажа товара
local function sellItems()
    local prompt = workspace.NPC.Seller2.HumanoidRootPart.SellSmuggledGoodsPrompt
    if prompt then
        pcall(function()
            prompt:InputHoldBegin(LocalPlayer)
            task.wait(0.5)
            prompt:InputHoldEnd(LocalPlayer)
        end)
        task.wait(0.3)
        pcall(function()
            prompt:InputHoldBegin(LocalPlayer)
            task.wait(0.5)
            prompt:InputHoldEnd(LocalPlayer)
        end)
    end
end

-- Покупка колец
local function buyItems()
    if fakeDiamondRingItem and purchaseRemote then
        for _ = 1, 10 do
            if not isFarming then break end
            pcall(function()
                purchaseRemote:FireServer(fakeDiamondRingItem)
            end)
            task.wait(0.1)
        end
    end
end

-- Отмывка денег
local function launderMoney()
    if launderPromptPart and launderRemote then
        for _ = 1, 10 do
            if not isFarming then break end
            pcall(function()
                launderRemote:FireServer(launderPromptPart)
            end)
            task.wait(0.1)
        end
    end
end

-- Перемещение к точке
local function moveTowards(part, targetPos)
    if not part then return end
    local distance = (targetPos - part.Position).Magnitude
    while distance > 0.1 do
        if not isFarming then break end
        local dt = RunService.Heartbeat:Wait()
        part.CFrame = part.CFrame + (targetPos - part.Position).Unit * math.min(SPEED * dt * 8, distance)
        distance = (targetPos - part.Position).Magnitude
    end
end

-- Аварийное восстановление (если застрял)
local function recover()
    if isRecovering then return end
    isRecovering = true
    isMoving = false
    stuckTimer = 0
    phaseTimer = os.clock()
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        moveTowards(root, START_POS)
    end
    
    currentRoute = ROUTE_BUY_SELL
    currentPhase = 1
    waypointIndex = 1
    isFirstBuy = false
    isRecovering = false
    isMoving = true
end

-- Остановка фарма
local function stopFarm()
    isFarming = false
    isMoving = false
    isRecovering = false
    stuckTimer = 0
    phaseTimer = 0
    
    toggleBtn.Text = "▶ START"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    statusLabel.Text = "🔴 DISABLED"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    
    if getgenv().routeConnection then getgenv().routeConnection:Disconnect() end
    if getgenv().noclippingConnection then getgenv().noclippingConnection:Disconnect() end
    
    task.wait(0.1)
    
    -- Восстановление коллизий
    for part, _ in pairs(getgenv().NoclipParts) do
        if typeof(part) == "Instance" and part:IsA("BasePart") and part.Parent then
            part.CanCollide = true
        end
    end
    getgenv().NoclipParts = {}
end

-- Запуск фарма
local function startFarm()
    isFarming = true
    isMoving = false
    isFirstBuy = true
    currentRoute = ROUTE_BUY_SELL
    currentPhase = 1
    waypointIndex = 1
    
    toggleBtn.Text = "⏹ STOP"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    statusLabel.Text = "🟢 FARMING"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    
    phaseTimer = os.clock()
    
    -- Noclip
    getgenv().noclippingConnection = RunService.Stepped:Connect(function()
        if isFarming and LocalPlayer.Character then
            for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                    getgenv().NoclipParts[part] = true
                end
            end
        end
    end)
    
    -- Логика маршрута
    task.spawn(function()
        while isFarming do
            if isRecovering then
                task.wait(0.5)
            else
                if os.clock() - phaseTimer > PHASE_TIMEOUT then
                    task.spawn(recover)
                    task.wait(1)
                else
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local targetPos = currentRoute[waypointIndex]
                        local dist = (targetPos - root.Position).Magnitude
                        
                        if dist < 4 then
                            phaseTimer = os.clock()
                            
                            if currentPhase == 1 then
                                if waypointIndex == 1 then
                                    if isFirstBuy then
                                        isFirstBuy = false
                                        isMoving = false
                                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        print("[FARM] Покупка (FireServer)")
                                        buyItems()
                                        if isFarming then
                                            waypointIndex = 2
                                            isMoving = true
                                            task.wait()
                                        end
                                    end
                                elseif waypointIndex == #ROUTE_BUY_SELL then
                                    isMoving = false
                                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    print("[FARM] Продажа (2 нажатия)")
                                    sellItems()
                                    if isFarming then
                                        currentRoute = ROUTE_SELL_LAUNDER
                                        currentPhase = 2
                                        waypointIndex = 2
                                        isMoving = true
                                    end
                                elseif waypointIndex == 5 then
                                    isMoving = false
                                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    task.wait(0.2)
                                    if isFarming then
                                        waypointIndex = waypointIndex + 1
                                        isMoving = true
                                    end
                                else
                                    -- ИСПРАВЛЕНИЕ: Оригинальный скрипт не увеличивал индекс здесь, вызывая залипание.
                                    waypointIndex = waypointIndex + 1
                                end
                            elseif currentPhase == 2 then
                                if waypointIndex == #ROUTE_SELL_LAUNDER then
                                    isMoving = false
                                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    print("[FARM] Отмывка (FireServer)")
                                    launderMoney()
                                    if isFarming then
                                        currentRoute = ROUTE_LAUNDER_START
                                        currentPhase = 3
                                        waypointIndex = 2
                                        isMoving = true
                                    end
                                else
                                    -- ИСПРАВЛЕНИЕ: То же самое для второй фазы.
                                    waypointIndex = waypointIndex + 1
                                end
                            elseif currentPhase == 3 then
                                if waypointIndex == #ROUTE_LAUNDER_START then
                                    currentRoute = ROUTE_BUY_SELL
                                    currentPhase = 1
                                    waypointIndex = 1
                                    isMoving = true
                                else
                                    -- ИСПРАВЛЕНИЕ: То же самое для третьей фазы.
                                    waypointIndex = waypointIndex + 1
                                end
                            end
                        end
                    end
                end
            end
            task.wait()
        end
    end)
    
    -- Движение и застревание
    getgenv().routeConnection = RunService.Heartbeat:Connect(function(dt)
        if not isFarming or isRecovering then return end
        
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local targetPos = currentRoute[waypointIndex]
        local prevPos = (waypointIndex > 1 and currentRoute[waypointIndex - 1]) or root.Position
        
        if isMoving then
            -- Проекция текущей позиции на линию маршрута
            local segmentVec = targetPos - prevPos
            local pointVec = root.Position - prevPos
            local segMagSq = segmentVec.Magnitude ^ 2
            
            local closestPoint = prevPos
            if segMagSq > 0 then
                local t = math.clamp(pointVec:Dot(segmentVec) / segMagSq, 0, 1)
                closestPoint = prevPos + segmentVec * t
            end
            
            local distToPath = (root.Position - closestPoint).Magnitude
            
            if distToPath > OFF_ROUTE_THRESHOLD then
                if stuckTimer == 0 then stuckTimer = os.clock() end
                if os.clock() - stuckTimer > STUCK_TIMEOUT then
                    task.spawn(recover)
                    return
                end
                
                local moveDir = closestPoint - root.Position
                if moveDir.Magnitude > 0.1 then
                    char:TranslateBy(moveDir.Unit * SPEED * dt * 8)
                end
            else
                stuckTimer = 0
                char:TranslateBy((targetPos - root.Position).Unit * SPEED * dt * 8)
            end
        end
    end)
end

