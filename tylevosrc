local function serializeConfig()
    local lines = {}
    local function add(key, value)
        lines[#lines + 1] = key .. "=" .. value
    end

    add("accent", math.round(Theme.Accent.R * 255) .. ","
        .. math.round(Theme.Accent.G * 255) .. ","
        .. math.round(Theme.Accent.B * 255))
    add("aim_enabled", tostring(aimState.Enabled))
    add("aim_showfov", tostring(aimState.ShowFov))
    add("aim_fov", tostring(aimState.Fov))
    add("aim_bone", aimState.Part)
    add("aim_wallcheck", tostring(aimState.WallCheck))
    add("aim_bind_type", aimBind.Type)
    add("aim_bind_value", aimBind.Value.Name)
    add("phone_enabled", tostring(phoneAimState.Enabled))
    add("phone_showfov", tostring(phoneAimState.ShowFov))
    add("phone_fov", tostring(phoneAimState.Fov))
    add("esp_criminal", tostring(espCriminalState.Enabled))
    add("esp_police", tostring(espPoliceState.Enabled))
    add("esp_distance_limit", tostring(_G.UseDistanceLimit))
    add("esp_distance", tostring(_G.EspDistance))
    add("esp_names", tostring(_G.ShowEspNames))
    add("esp_health", tostring(_G.ShowEspHealth))
    add("esp_stars", tostring(_G.ShowEspStars))

    local factionKeys = { "Civilian", "BorderPatrol", "Bortac", "Police", "Swat", "UsArmy" }
    for _, faction in ipairs(factionKeys) do
        local color = _G["Color_" .. faction]
        if color then
            add("color_" .. faction,
                math.round(color.R * 255) .. ","
                .. math.round(color.G * 255) .. ","
                .. math.round(color.B * 255))
        end
    end

    return "TYLEVELO CONFIG\n" .. table.concat(lines, "\n")
end

