local function createSlider(parent, label, min, max, default, callback, settingKey)
    local frame = create("Frame", {
        Parent = parent,
        BackgroundColor3 = Theme.BgSidebar,
        Size = UDim2.new(1, 0, 0, 46),
        LayoutOrder = nextOrder(),
    })
    corner(frame, 8)
    create("UIPadding", { Parent = frame, PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) })

    local valueLabel = create("TextLabel", {
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = label .. ": " .. tostring(default),
        TextColor3 = Theme.TextMain,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local track = create("Frame", {
        Parent = frame,
        BackgroundColor3 = Theme.BgPanel,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 24),
        Size = UDim2.new(1, 0, 0, 8),
    })
    corner(track, 4)

    local fill = create("Frame", {
        Parent = track,
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    })
    corner(fill, 4)
    table.insert(accentIndicators, fill)

    local knob = create("Frame", {
        Parent = track,
        BackgroundColor3 = Theme.TextMain,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0.5, -6),
        Size = UDim2.new(0, 12, 0, 12),
    })
    corner(knob, 6)

    local dragging = false

    local function setFromX(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pct)
        local fillPct = (val - min) / (max - min)
        fill.Size = UDim2.new(fillPct, 0, 1, 0)
        knob.Position = UDim2.new(fillPct, -6, 0.5, -6)
        valueLabel.Text = label .. ": " .. tostring(val)
        callback(val)
    end

    local function setValue(val)
        local pct = (val - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -6, 0.5, -6)
        valueLabel.Text = label .. ": " .. tostring(val)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(UserInputService:GetMouseLocation().X)
        end
    end)
    track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(UserInputService:GetMouseLocation().X)
        end
    end)

    local initPct = (default - min) / (max - min)
    fill.Size = UDim2.new(initPct, 0, 1, 0)
    knob.Position = UDim2.new(initPct, -6, 0.5, -6)

    if settingKey then
        themeUpdaters[settingKey] = themeUpdaters[settingKey] or {}
        table.insert(themeUpdaters[settingKey], setValue)
    end

    return frame
end

