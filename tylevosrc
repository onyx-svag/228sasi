local function fullCleanup()
    -- FOV circles
    if fovFrame then pcall(function() fovFrame:Destroy() end); fovFrame = nil end
    if phoneFovFrame then pcall(function() phoneFovFrame:Destroy() end); phoneFovFrame = nil end

    -- ESP folders
    if criminalEspFolder then pcall(function() criminalEspFolder:Destroy() end); criminalEspFolder = nil end
    if policeEspFolder then pcall(function() policeEspFolder:Destroy() end); policeEspFolder = nil end

    -- Очистка хайлайтов у всех игроков
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            local getReal = player.Character:FindFirstChild("GetReal")
            if getReal then pcall(function() getReal:Destroy() end) end
            local getRealPol = player.Character:FindFirstChild("GetRealPol")
            if getRealPol then pcall(function() getRealPol:Destroy() end) end
        end
    end

    -- Noclip
    if noclipConn then pcall(function() noclipConn:Disconnect() end); noclipConn = nil end

    -- Полёт
    if bodyVelocity then pcall(function() bodyVelocity:Destroy() end); bodyVelocity = nil end
    if bodyGyro then pcall(function() bodyGyro:Destroy() end); bodyGyro = nil end
end

_G.TYLEVELO_CLEANUP = fullCleanup

