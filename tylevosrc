local function inputDisplayName(input)
    if input.Type == "Mouse" then
        local map = {
            [Enum.UserInputType.MouseButton1] = "LMB",
            [Enum.UserInputType.MouseButton2] = "RMB",
            [Enum.UserInputType.MouseButton3] = "MMB",
            [Enum.UserInputType.MouseButton4] = "Side Mouse 1",
            [Enum.UserInputType.MouseButton5] = "Side Mouse 2",
        }
        return map[input.Value] or "?"
    elseif input.Type == "Key" then
        local name = tostring(input.Value)
        return (name:gsub("^Enum%.KeyCode%.", ""))
    end
    return "?"
end

