local panels = {}       -- [id] = ScrollingFrame
local navButtons = {}   -- [id] = { Btn, Indicator, Label, Target }
local activePanel = nil

local function switchPanel(buttonData, panelId, label)
    if activePanel == buttonData.Btn then return end

    -- Деактивация текущей
    if activePanel then
        local old = navButtons[activePanel]
        if old then
            TweenService:Create(old.Label, TweenInfo.new(0.15), { TextColor3 = Theme.TextDim }):Play()
            TweenService:Create(old.Indicator, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 0, 1, 0) }):Play()
            panels[old.Target].Visible = false
        end
    end

    activePanel = buttonData.Btn

    -- Активация новой
    buttonData.Indicator.BackgroundColor3 = Theme.Accent
    buttonData.Indicator.Visible = true
    buttonData.Indicator.Size = UDim2.new(0, 0, 1, 0)
    TweenService:Create(buttonData.Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 3, 1, 0) }):Play()
    TweenService:Create(buttonData.Label, TweenInfo.new(0.15), { TextColor3 = Theme.Accent }):Play()

    panels[panelId].Visible = true
    local scale = panels[panelId]:FindFirstChild("UIScale")
    if scale then
        scale.Scale = 0.97
        TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    end

    subtitleLabel.Text = label
    subtitleLabel.TextTransparency = 1
    TweenService:Create(subtitleLabel, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
end

-- Создание вкладки
local function createPanel(id, name, iconUrl, emoji)
    local navBtn = create("TextButton", {
        Parent = navScroll,
        BackgroundColor3 = Theme.BgRow,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 32),
        Text = "",
    })
    corner(navBtn, 6)

    local indicator = create("Frame", {
        Parent = navBtn,
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 3, 1, 0),
        Visible = false,
    })
    corner(indicator, 3)
    table.insert(accentIndicators, indicator)

    local label = create("TextLabel", {
        Parent = navBtn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0),
        Size = UDim2.new(1, -16, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = name,
        TextColor3 = Theme.TextDim,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    table.insert(accentTextLabels, label)

    -- Иконка
    if emoji then
        if iconUrl then
            create("TextLabel", {
                Parent = navBtn,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 13, 0.5, -9),
                Size = UDim2.new(0, 18, 0, 18),
                Font = Enum.Font.SourceSansBold,
                Text = emoji,
                TextColor3 = Color3.new(1, 1, 1),
                TextSize = 15,
                TextXAlignment = Enum.TextXAlignment.Center,
            })
        end
        create("ImageLabel", {
            Parent = navBtn,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 13, 0.5, -9),
            Size = UDim2.new(0, 18, 0, 18),
            Image = iconUrl,
            ScaleType = Enum.ScaleType.Fit,
        })
        label.Position = UDim2.new(0, 38, 0, 0)
        label.Size = UDim2.new(1, -38, 1, 0)
    end

    -- Скроллер панели контента
    local panelScroll = create("ScrollingFrame", {
        Parent = contentContainer,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Border,
        Visible = false,
    })
    create("UIScale", { Parent = panelScroll })

    local layout = create("UIListLayout", {
        Parent = panelScroll,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
    })
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        panelScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 32)
    end)
    create("UIPadding", {
        Parent = panelScroll,
        PaddingTop = UDim.new(0, 16),
        PaddingLeft = UDim.new(0, 16),
        PaddingRight = UDim.new(0, 16),
        PaddingBottom = UDim.new(0, 16),
    })

    -- Hover эффекты
    navBtn.MouseEnter:Connect(function()
        if activePanel ~= navBtn then
            TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = Theme.TextMain }):Play()
            TweenService:Create(navBtn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.6 }):Play()
        end
    end)
    navBtn.MouseLeave:Connect(function()
        if activePanel ~= navBtn then
            TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = Theme.TextDim }):Play()
            TweenService:Create(navBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
        end
    end)

    local buttonData = { Btn = navBtn, Indicator = indicator, Label = label, Target = id }
    navBtn.MouseButton1Click:Connect(function()
        switchPanel(buttonData, id, name)
    end)

    panels[id] = panelScroll
    navButtons[id] = buttonData

    return panelScroll
end

