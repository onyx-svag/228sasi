<!-- ESP: СОЗДАНИЕ ОБЪЕКТОВ ДЛЯ ИГРОКА -->
-- ============================================================
local function createEspObjects(player, espFolder, boxTemplate, tagTemplate, teamColorFunc, nametagUpdater)
    if player == LocalPlayer then return end

    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return end

    local color = teamColorFunc(player)
    if not color then
        -- Очистка
        local existing = espFolder:FindFirstChild(player.Name)
        if existing then existing:ClearAllChildren() end
        local getReal = char:FindFirstChild("GetReal") or char:FindFirstChild("GetRealPol")
        if getReal then getReal:Destroy() end
        return
    end

    local playerFolder = espFolder:FindFirstChild(player.Name)
    if not playerFolder then
        playerFolder = Instance.new("Folder")
        playerFolder.Name = player.Name
        playerFolder.Parent = espFolder
    end
    playerFolder:ClearAllChildren()

    -- Box adornment
    local box = boxTemplate:Clone()
    box.Name = player.Name .. "Box"
    box.Adornee = char
    box.Color3 = color
    box.Visible = true
    box.Parent = playerFolder

    -- Name tag
    local tag = tagTemplate:Clone()
    tag.Name = player.Name .. "NameTag"
    tag.Enabled = true
    local head = char:WaitForChild("Head", 5)
    tag.Adornee = head
    if tag.Adornee then
        tag.Tag.TextColor3 = color
        nametagUpdater(player, tag.Tag)
        tag.Parent = playerFolder
    end

    -- Highlight
    local highlightName = (espFolder.Name == "TYLEVELO_ESP") and "GetReal" or "GetRealPol"
    local existingHighlight = char:FindFirstChild(highlightName)
    if not existingHighlight then
        local highlight = Instance.new("Highlight")
        highlight.Name = highlightName
        highlight.Adornee = char
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = color
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = color
        highlight.OutlineTransparency = 0
        highlight.Parent = char
    else
        existingHighlight.Enabled = true
        existingHighlight.FillColor = color
        existingHighlight.OutlineColor = color
    end
end

-- ============================================================
-- ESP: ОЧИСТКА ОБЪЕКТОВ ИГРОКА
-- ============================================================
local function clearEspObjects(player, espFolder)
    local folder = espFolder:FindFirstChild(player.Name)
    if folder then folder:ClearAllChildren() end

    local char = player.Character
    if char then
        local getReal = char:FindFirstChild("GetReal")
        if getReal then getReal:Destroy() end
        local getRealPol = char:FindFirstChild("GetRealPol")
        if getRealPol then getRealPol:Destroy() end
    end
end

-- ============================================================
-- ESP: ПРИВЯЗКА К ИГРОКУ
-- ============================================================
local function setupPlayerEsp(player, espFolder, boxTemplate, tagTemplate, teamColorFunc, nametagUpdater, highlightName)
    if player == LocalPlayer then return end

    player.CharacterAdded:Connect(function()
        if player.Character then
            while not player.Character:FindFirstChild("Humanoid") do
                task.wait()
            end
        end
        pcall(createEspObjects, player, espFolder, boxTemplate, tagTemplate, teamColorFunc, nametagUpdater)
    end)

    player.CharacterRemoving:Connect(function()
        pcall(clearEspObjects, player, espFolder)
    end)

    player:GetPropertyChangedSignal("Team"):Connect(function()
        pcall(clearEspObjects, player, espFolder)
        task.wait(0.1)
        pcall(createEspObjects, player, espFolder, boxTemplate, tagTemplate, teamColorFunc, nametagUpdater)
    end)
end

