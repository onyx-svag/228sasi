                local part = char:FindFirstChild(phoneAimState.Part)
                if part then
                    local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < shortestDist and dist <= phoneAimState.Fov then
                            shortestDist = dist
                            target = player
                        end
                    end
                end
