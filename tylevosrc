<!-- КОНФИГ: ЗАГРУЗКА -->
-- ============================================================
local function deserializeConfig(text)
    for line in text:gmatch("[^\r\n]+") do
        if line ~= "TYLEVELO CONFIG" then
            local key, value = line:match("^([%w_]+)=(.*)$")
            if key and value then
                if key == "accent" then
                    local r, g, b = value:match("^(%d+),(%d+),(%d+)$")
                    if r then
                        setAccent(Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)))
                    end
                elseif key == "aim_enabled" then
                    aimState.Enabled = value == "true"
                elseif key == "aim_showfov" then
                    aimState.ShowFov = value == "true"
                elseif key == "aim_fov" then
                    local n = tonumber(value)
                    if n then aimState.Fov = n end
                elseif key == "aim_bone" then
                    aimState.Part = value
                    if boneBtn then boneBtn.Text = value end
                elseif key == "aim_wallcheck" then
                    aimState.WallCheck = value == "true"
                elseif key == "aim_bind_type" then
                    aimBind.Type = value
                elseif key == "aim_bind_value" then
                    if aimBind.Type == "Mouse" then
                        aimBind.Value = Enum.UserInputType[value]
                    else
                        aimBind.Value = Enum.KeyCode[value]
                    end
                elseif key == "phone_enabled" then
                    phoneAimState.Enabled = value == "true"
                elseif key == "phone_showfov" then
                    phoneAimState.ShowFov = value == "true"
                elseif key == "phone_fov" then
                    local n = tonumber(value)
                    if n then phoneAimState.Fov = n end
                elseif key == "esp_criminal" then
                    espCriminalState.Enabled = value == "true"
                elseif key == "esp_police" then
                    espPoliceState.Enabled = value == "true"
                elseif key == "esp_distance_limit" then
                    local v = value == "true"
                    espCriminalState.DistanceLimit = v
                    espPoliceState.DistanceLimit = v
                    _G.UseDistanceLimit = v
                elseif key == "esp_distance" then
                    local n = tonumber(value)
                    if n then
                        espCriminalState.Distance = n
                        espPoliceState.Distance = n
                        _G.EspDistance = n
                    end
                elseif key == "esp_names" then
                    _G.ShowEspNames = value == "true"
                elseif key == "esp_health" then
                    _G.ShowEspHealth = value == "true"
                elseif key == "esp_stars" then
                    _G.ShowEspStars = value == "true"
                elseif key:match("^color_(.+)$") then
                    local faction = key:match("^color_(.+)$")
                    local r, g, b = value:match("^(%d+),(%d+),(%d+)$")
                    if r then
                        local color = Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
                        _G["Color_" .. faction] = color
                        applySetting("Color_" .. faction, color)
                    end
                end
            end
        end
    end

    -- Применить ко всем UI элементам
    applySetting("aim_enabled", aimState.Enabled)
    applySetting("aim_showfov", aimState.ShowFov)
    applySetting("aim_fov", aimState.Fov)
    applySetting("aim_wallcheck", aimState.WallCheck)
    applySetting("aim_bind", true)
    applySetting("phone_enabled", phoneAimState.Enabled)
    applySetting("phone_showfov", phoneAimState.ShowFov)
    applySetting("phone_fov", phoneAimState.Fov)
    applySetting("esp_criminal", espCriminalState.Enabled)
    applySetting("esp_police", espPoliceState.Enabled)
    applySetting("esp_distance_limit", _G.UseDistanceLimit)
    applySetting("esp_distance", _G.EspDistance)
    applySetting("esp_names", _G.ShowEspNames)
    applySetting("esp_health", _G.ShowEspHealth)
    applySetting("esp_stars", _G.ShowEspStars)
end

-- Сохранение конфига
local function saveConfig()
    local data = serializeConfig()
    local ok = false

    if savefile then
        ok = pcall(function() savefile("config.sandiego", data) end)
        if not ok then pcall(function() savefile(data) end) end
    end

    if not ok then
        ok = pcall(function()
            if makefolder and (not isfolder or not isfolder("tylevelo")) then
                makefolder("tylevelo")
            end
            writefile("tylevelo/config.sandiego", data)
        end)
    end

    return ok
end

-- Загрузка конфига
local function loadConfig()
    if openfile then
        local ok, data = pcall(openfile)
        if ok and data and data ~= "" then
            deserializeConfig(data)
            return true
        end
        return false
    else
        local ok, data = pcall(function()
            if isfile and isfile("tylevelo/config.sandiego") then
                return readfile("tylevelo/config.sandiego")
            else
                error("no file")
            end
        end)
        if ok and data then
            deserializeConfig(data)
            return true
        end
        return false
    end
end

-- Автозагрузка при старте
pcall(loadConfig)

