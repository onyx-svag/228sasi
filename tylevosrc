        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local toggleBtn = create("TextButton", {
        Parent = frame,
        BackgroundColor3 = Theme.BgPanel,
        Position = UDim2.new(1, -38, 0.5, -9),
        Size = UDim2.new(0, 38, 0, 18),
        Text = "",
    })
    corner(toggleBtn, 9)

    local knob = create("Frame", {
        Parent = toggleBtn,
        BackgroundColor3 = Theme.TextDim,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 2, 0.5, -6),
        Size = UDim2.new(0, 12, 0, 12),
    })
    corner(knob, 6)

    local state = default

    local function update()
        toggleBtn.BackgroundColor3 = state and Theme.Accent or Theme.BgPanel
        knob.Position = state and UDim2.new(0, 22, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
        if state then
            if not table.find(accentIndicators, toggleBtn) then
                table.insert(accentIndicators, toggleBtn)
            end
        else
            local idx = table.find(accentIndicators, toggleBtn)
            if idx then table.remove(accentIndicators, idx) end
        end
    end

    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        update()
        callback(state)
    end)
    update()

    if settingKey then
        themeUpdaters[settingKey] = themeUpdaters[settingKey] or {}
        table.insert(themeUpdaters[settingKey], function(val)
            state = val
            update()
            callback(val)
        end)
    end

    return toggleBtn
end

