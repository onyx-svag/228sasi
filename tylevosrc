local menuVisible = false

local function toggleMenu()
    if not menuVisible then return end

    if mainFrame.Visible then
        -- Скрыть
        local t1 = TweenService:Create(canvasGroup, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
        t1:Play()
        local t2 = TweenService:Create(uiScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.94 })
        t2:Play()
        task.delay(0.18, function()
            mainFrame.Visible = false
        end)
    else
        -- Показать
        mainFrame.Visible = true
        canvasGroup.GroupTransparency = 1
        uiScale.Scale = 0.94
        local t1 = TweenService:Create(canvasGroup, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 })
        t1:Play()
        local t2 = TweenService:Create(uiScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
        t2:Play()
    end
end

