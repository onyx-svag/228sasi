-- Полёт к точке
local function flyTo(targetPos)
    local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    setFlying(true)
    pressShift(true)

    local startTime = tick()
    while true do
        local dist = (targetPos - rootPart.Position).Magnitude
        if dist <= 3 then break end

        if not jobFarmEnabled then break end
        if _G.TYLEVELO_RESET then break end

        local direction = (targetPos - rootPart.Position).Unit
        if bodyVelocity then
            bodyVelocity.Velocity = direction * flightSpeed
        end
        if bodyGyro then
            bodyGyro.CFrame = CFrame.lookAlong(rootPart.Position, direction, Vector3.new(0, 1, 0))
        end

        if tick() - startTime > 60 then break end
        task.wait()
    end

    pressShift(false)
    if bodyVelocity then bodyVelocity.Velocity = Vector3.zero end
    task.wait(0.2)
    setFlying(false)
end

-- Ключевые слова для поиска объектов
local objectKeywords = { "box", "rack", "shelf", "crate", "carton", "chest", "sell", "drop", "pickup", "goods", "diamond", "ring" }

-- Поворот к объекту
local function faceDirection(targetPos)
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local flat = Vector3.new(targetPos.X, 0, targetPos.Z)
    if flat.Magnitude < 0.1 then return end

    rootPart.CFrame = CFrame.lookAlong(rootPart.Position, flat.Unit, Vector3.new(0, 1, 0))
end

-- Поиск и поворот к ближайшему объекту
local function faceNearestObject(centerPos, fallbackDir)
    local foundPart = nil

    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(centerPos, 30)
    end)

    if ok and type(parts) == "table" then
        for _, part in ipairs(parts) do
            if part:IsA("BasePart") and part.Anchored then
                if not part:IsDescendantOf(LocalPlayer.Character) then
                    local dist = (part.Position - centerPos).Magnitude
                    if dist < 30 then
                        local name = part.Name:lower()
                        for _, keyword in ipairs(objectKeywords) do
                            if name:find(keyword, 1, true) then
                                foundPart = part
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    if foundPart then
        faceDirection(foundPart.Position - centerPos)
    elseif fallbackDir then
        faceDirection(fallbackDir)
    end
end

-- Обработка одной точки маршрута
local function processRoutePoint(routePoint, prevPoint)
    faceNearestObject(routePoint, (routePoint - prevPoint).Unit)
    task.wait(0.2)
    pressE()
end

-- Обработка маршрута
local function flyRoute(route)
    faceNearestObject(route[1], (route[1] - route[2]).Unit)
    task.wait(0.2)
    pressE()

    for i = 2, #route do
        if not jobFarmEnabled then break end
        flyTo(route[i])
        faceNearestObject(route[i], (route[i] - route[i - 1]).Unit)
        task.wait(0.2)
        pressE()
    end
end

-- Главный цикл фарма
local function jobFarmLoop()
    setNoclip(true)

    -- Обратный маршрут
    local reverseRoute = {}
    for i = #routePoints, 1, -1 do
        reverseRoute[#reverseRoute + 1] = routePoints[i]
    end

    while jobFarmEnabled do
        if _G.TYLEVELO_RESET then break end

        flyTo(routePoints[1])
        flyRoute(routePoints)
        boxesCounter = boxesCounter + 1
        updateCounter()

        if not jobFarmEnabled then break end

        flyRoute(reverseRoute)
        boxesCounter = boxesCounter + 1
        updateCounter()
    end

    setNoclip(false)
    statusLabel.Text = "Status: off"
end

local function setJobFarm(enabled)
    jobFarmEnabled = enabled
    if enabled then
        task.spawn(jobFarmLoop)
    end
end

