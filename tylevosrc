        Parent = frame,
        BackgroundColor3 = Theme.BgPanel,
        Position = UDim2.new(1, -124, 0.5, -10),
        Size = UDim2.new(0, 124, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = inputDisplayName(currentInput),
        TextColor3 = Theme.TextMain,
        TextSize = 11,
    })
    corner(displayBtn, 6)
    stroke(displayBtn, Theme.Border)

    local listening = false

    displayBtn.MouseButton1Click:Connect(function()
        listening = true
        displayBtn.Text = "..."
        displayBtn.TextColor3 = Theme.Accent
    end)

    UserInputService.InputBegan:Connect(function(input)
        if not listening then return end

        local captured = false

        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
            currentInput = { Type = "Key", Value = input.KeyCode }
            captured = true
        elseif input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.MouseButton2
        or input.UserInputType == Enum.UserInputType.MouseButton3
        or input.UserInputType == Enum.UserInputType.MouseButton4
        or input.UserInputType == Enum.UserInputType.MouseButton5 then
            currentInput = { Type = "Mouse", Value = input.UserInputType }
            captured = true
        elseif input.UserInputType == Enum.UserInputType.Touch then
            captured = true  -- игнорируем тач
        end

        if captured then
            listening = false
            displayBtn.Text = inputDisplayName(currentInput)
            displayBtn.TextColor3 = Theme.TextMain
            callback(currentInput)
        end
    end)

    if settingKey then
        themeUpdaters[settingKey] = themeUpdaters[settingKey] or {}
        table.insert(themeUpdaters[settingKey], function()
            displayBtn.Text = inputDisplayName(currentInput)
            displayBtn.TextColor3 = Theme.TextMain
        end)
    end

    return frame
end

