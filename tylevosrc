local function updateCriminalNametag(player, tagLabel)
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return end

    local name = _G.ShowEspNames and player.Name or ""
    local health = _G.ShowEspHealth and (" [" .. math.floor(char.Humanoid.Health) .. " HP]") or ""
    tagLabel.Text = name .. health
end

-- ============================================================
-- ESP: ОБНОВЛЕНИЕ ТЕКСТА НАМТЕЙГА (Police)
-- ============================================================
local function updatePoliceNametag(player, tagLabel)
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return end

    local name = _G.ShowEspNames and player.Name or ""
    local stars = ""
    if _G.ShowEspStars then
        local s = getWantedStars(player)
        if s ~= "" then
            stars = " " .. s
        end
    end
    local health = _G.ShowEspHealth and (" [" .. math.floor(char.Humanoid.Health) .. " HP]") or ""
    tagLabel.Text = name .. stars .. health
end

