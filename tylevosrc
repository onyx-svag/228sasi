-- Получение цвета фракции игрока
local function getTeamColor(player)
    local teamName = player.Team and player.Team.Name or ""
    if teamName == "Civilian" then return nil end  -- Civilians не подсвечиваются в criminal ESP
    if teamName == "Border Patrol" then return _G.Color_BorderPatrol end
    if teamName == "Bortac" then return _G.Color_Bortac end
    if teamName == "Police" then return _G.Color_Police end
    if teamName == "Swat" then return _G.Color_Swat end
    if teamName == "Us Army" then return _G.Color_UsArmy end
    return player.TeamColor and player.TeamColor.Color
end

-- Получение цвета фракции игрока (для Police ESP — включая Civilian)
local function getTeamColorPolice(player)
    local teamName = player.Team and player.Team.Name or ""
    if teamName == "Civilian" then return _G.Color_Civilian end
    if teamName == "Border Patrol" then return _G.Color_BorderPatrol end
    if teamName == "Bortac" then return _G.Color_Bortac end
    if teamName == "Police" then return _G.Color_Police end
    if teamName == "Swat" then return _G.Color_Swat end
    if teamName == "Us Army" then return _G.Color_UsArmy end
    return player.TeamColor and player.TeamColor.Color
end

-- Получение звёзд розыска
local function getWantedStars(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return "" end

    local wanted = leaderstats:FindFirstChild("Wanted")
    if not wanted then
        wanted = leaderstats:FindFirstChild("WantedLevel")
    end
    if not wanted then
        wanted = leaderstats:FindFirstChild("Stars")
    end
    if not wanted then
        wanted = leaderstats:FindFirstChild("Wanted Level")
    end

    if wanted and wanted:IsA("ValueBase") then
        local level = tonumber(wanted.Value) or 0
        if level > 0 then
            return string.rep("★", math.clamp(level, 1, 6))
        end
    end
    return ""
end

