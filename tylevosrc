local function isBindPressed()
    if UserInputService.TouchEnabled then
        local touches = UserInputService:GetTouches()
        return #touches > 0
    elseif aimBind.Type == "Mouse" then
        return UserInputService:IsMouseButtonPressed(aimBind.Value)
    else
        return UserInputService:IsKeyDown(aimBind.Value)
    end
end

-- ============================================================
-- ПРОВЕРКА: НАВЕДЁН ЛИ КУРСОР НА UI
-- ============================================================
local function isMouseOverUI(uiElement)
    if not uiElement or not uiElement.Parent then return false end

    local pos = uiElement.AbsolutePosition
    local size = uiElement.AbsoluteSize

    for _, touch in ipairs(UserInputService:GetTouches()) do
        if touch.Position.X >= pos.X
        and touch.Position.X <= pos.X + size.X
        and touch.Position.Y >= pos.Y
        and touch.Position.Y <= pos.Y + size.Y then
            return true
        end
    end
    return true
end

